    "document_html": "<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Constructeur de Protocole d&#x27;Études Cliniques Personnalisé | Rationalisez la conception de vos essais cliniques avec précision.</title>\n    <meta name=\"description\" content=\"Générez des ébauches de protocoles pour vos essais cliniques en sélectionnant des paramètres clés et des sections standardisées. Accélérez la phase de conception de vos études.\">\n    <style>\n        :root {\n            --bg-color: #1a1a1a;\n            --text-color: #f0f0f0;\n            --primary-color: #b89a69; /* Sandline-inspired, darker gold */\n            --secondary-color: #4a4a4a;\n            --border-color: #333;\n            --font-family-headline: 'Georgia', serif;\n            --font-family-body: 'Arial', sans-serif;\n        }\n\n        body {\n            font-family: var(--font-family-body);\n            background-color: var(--bg-color);\n            color: var(--text-color);\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n        }\n\n        header {\n            background-color: var(--secondary-color);\n            padding: 20px 40px;\n            border-bottom: 1px solid var(--border-color);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        h1 {\n            font-family: var(--font-family-headline);\n            color: var(--primary-color);\n            font-size: 2.2em;\n            margin: 0;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        .container {\n            display: flex;\n            flex-grow: 1;\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 20px 0;\n        }\n\n        .main-content {\n            flex: 3;\n            padding: 0 40px;\n            border-right: 1px solid var(--border-color);\n        }\n\n        .tool-rail {\n            flex: 2;\n            padding: 0 40px;\n        }\n\n        h2, h3 {\n            font-family: var(--font-family-headline);\n            color: var(--primary-color);\n            margin-top: 1.5em;\n            margin-bottom: 0.8em;\n            font-weight: normal;\n        }\n\n        p {\n            margin-bottom: 1em;\n            color: #ccc;\n        }\n\n        .statement-block {\n            margin-bottom: 40px;\n        }\n\n        .statement-block h2 {\n            font-size: 2.5em;\n            line-height: 1.2;\n            margin-bottom: 20px;\n            text-transform: none;\n            letter-spacing: normal;\n        }\n\n        .statement-block p {\n            font-size: 1.1em;\n            max-width: 700px;\n        }\n\n        form#tool-form {\n            background-color: var(--secondary-color);\n            padding: 30px;\n            border-radius: 4px;\n            border: 1px solid var(--border-color);\n            margin-bottom: 30px;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 8px;\n            color: var(--primary-color);\n            font-weight: bold;\n            font-size: 0.95em;\n        }\n\n        input[type=\"text\"],\n        select,\n        textarea {\n            width: calc(100% - 20px);\n            padding: 10px;\n            margin-bottom: 20px;\n            border: 1px solid var(--border-color);\n            background-color: #333;\n            color: var(--text-color);\n            border-radius: 3px;\n            box-sizing: border-box;\n            font-family: var(--font-family-body);\n        }\n\n        textarea {\n            min-height: 100px;\n            resize: vertical;\n        }\n\n        button#tool-submit {\n            background-color: var(--primary-color);\n            color: var(--bg-color);\n            padding: 12px 25px;\n            border: none;\n            border-radius: 3px;\n            cursor: pointer;\n            font-size: 1.1em;\n            font-weight: bold;\n            transition: background-color 0.3s ease;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n        }\n\n        button#tool-submit:hover {\n            background-color: #d1b17b;\n        }\n\n        .section-group {\n            margin-bottom: 25px;\n            padding: 15px;\n            background-color: #2b2b2b;\n            border-radius: 4px;\n            border: 1px solid #3d3d3d;\n        }\n\n        .section-group label {\n            color: #d0d0d0;\n            font-weight: normal;\n            margin-bottom: 5px;\n        }\n\n        .section-group input[type=\"checkbox\"] {\n            margin-right: 8px;\n        }\n\n        #tool-result {\n            background-color: var(--secondary-color);\n            padding: 30px;\n            border-radius: 4px;\n            border: 1px solid var(--border-color);\n            min-height: 200px;\n            white-space: pre-wrap;\n            font-family: monospace;\n            color: #e0e0e0;\n            margin-top: 30px;\n            overflow-x: auto;\n        }\n\n        .result-section h3 {\n            color: var(--primary-color);\n            border-bottom: 1px solid var(--border-color);\n            padding-bottom: 5px;\n            margin-top: 25px;\n            margin-bottom: 15px;\n        }\n        .result-section p {\n            color: #ccc;\n            margin-bottom: 0.5em;\n        }\n\n        footer {\n            background-color: var(--secondary-color);\n            padding: 40px;\n            border-top: 1px solid var(--border-color);\n            text-align: center;\n            color: #999;\n            margin-top: 40px;\n        }\n\n        footer p {\n            margin: 0;\n            font-size: 0.9em;\n        }\n\n        .seo-block {\n            margin-top: 50px;\n            padding-top: 30px;\n            border-top: 1px solid var(--border-color);\n            text-align: left;\n            color: #b0b0b0;\n        }\n\n        .seo-block h2 {\n            font-size: 1.8em;\n            text-align: center;\n            margin-bottom: 20px;\n            color: var(--primary-color);\n        }\n\n        .seo-block p {\n            margin-bottom: 1em;\n            line-height: 1.7;\n            color: #a0a0a0;\n        }\n\n        .seo-block ul {\n            list-style: none;\n            padding: 0;\n            margin-top: 20px;\n            display: flex;\n            flex-wrap: wrap;\n            justify-content: center;\n            gap: 15px;\n        }\n\n        .seo-block li {\n            background-color: #2b2b2b;\n            padding: 8px 15px;\n            border-radius: 20px;\n            font-size: 0.9em;\n            color: var(--primary-color);\n            border: 1px solid var(--border-color);\n        }\n\n        @media (max-width: 900px) {\n            .container {\n                flex-direction: column;\n            }\n            .main-content {\n                border-right: none;\n                border-bottom: 1px solid var(--border-color);\n                padding-bottom: 30px;\n            }\n            .tool-rail {\n                padding-top: 30px;\n            }\n            header {\n                flex-direction: column;\n                align-items: flex-start;\n            }\n            h1 {\n                margin-bottom: 10px;\n            }\n        }\n\n        @media (max-width: 600px) {\n            header, .main-content, .tool-rail {\n                padding: 15px 20px;\n            }\n            h1 {\n                font-size: 1.8em;\n            }\n            .statement-block h2 {\n                font-size: 2em;\n            }\n        }\n\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://constructeur-de-protocole-d-etudes-cliniques-pe-c03c27f8.onrender.com\">\n    <meta property=\"og:title\" content=\"Constructeur de Protocole d&#x27;Études Cliniques Personnalisé\">\n    <meta property=\"og:description\" content=\"Générez des ébauches de protocoles pour vos essais cliniques en sélectionnant des paramètres clés et des sections standardisées. Accélérez la phase de conception de vos études.\">\n    <meta property=\"og:url\" content=\"https://constructeur-de-protocole-d-etudes-cliniques-pe-c03c27f8.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Constructeur de Protocole d'Études Cliniques Personnalisé\", \"description\": \"Générez des ébauches de protocoles pour vos essais cliniques en sélectionnant des paramètres clés et des sections standardisées. Accélérez la phase de conception de vos études.\", \"url\": \"https://constructeur-de-protocole-d-etudes-cliniques-pe-c03c27f8.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"constructeur-de-protocole-d-etudes-cliniques-pe-c03c27f8\" data-runtime-mode=\"document_generator\">\n    <header>\n        <h1>Constructeur de Protocole d'Études Cliniques</h1>\n    </header>\n\n    <div class=\"container\">\n        <div class=\"main-content\">\n            <section class=\"statement-block\">\n                <h2>Rationalisez la conception de vos essais cliniques avec précision.</h2>\n                <p>Développé pour les chercheurs et les CROs, notre outil intuitif vous permet de générer rapidement des ébauches de protocoles d'études cliniques. Sélectionnez les paramètres clés et intégrez des sections standardisées pour assurer rigueur et conformité, accélérant ainsi significativement votre phase de conception. Gagnez en efficacité, maintenez la qualité.</p>\n                <p>Éliminez les tâches répétitives et concentrez-vous sur l'innovation. Notre plateforme est conçue pour la rigueur scientifique, la flexibilité et l'intégration facile dans vos workflows existants.</p>\n            </section>\n\n            <section id=\"tool-result\">\n                <h3 id=\"result-headline\">Votre Protocole Généré Apparaîtra Ici</h3>\n                <p>Configurez les options dans le panneau de droite et cliquez sur \"Générer le Protocole\" pour voir votre ébauche ici.</p>\n            </section>\n        </div>\n\n        <div class=\"tool-rail\">\n            <form id=\"tool-form\">\n                <h2>Paramètres du Protocole</h2>\n\n                <label for=\"studyTitle\">Titre de l'étude (Provisoire)</label>\n                <input type=\"text\" id=\"studyTitle\" placeholder=\"Ex: Étude de Phase III sur le composé XYZ pour l'hypertension\" required>\n\n                <label for=\"studyPhase\">Phase de l'étude</label>\n                <select id=\"studyPhase\" required>\n                    <option value=\"\">Sélectionnez une phase</option>\n                    <option value=\"Phase I\">Phase I</option>\n                    <option value=\"Phase II\">Phase II</option>\n                    <option value=\"Phase III\">Phase III</option>\n                    <option value=\"Phase IV\">Phase IV</option>\n                    <option value=\"Observationnelle\">Observationnelle</option>\n                </select>\n\n                <label for=\"therapeuticArea\">Domaine thérapeutique</label>\n                <input type=\"text\" id=\"therapeuticArea\" placeholder=\"Ex: Oncologie, Cardiologie, Neurologie\" required>\n\n                <label for=\"intervention\">Intervention/Produit à l'étude</label>\n                <input type=\"text\" id=\"intervention\" placeholder=\"Ex: Molécule ABC, Thérapie génique, Dispositif médical\" required>\n\n                <label for=\"population\">Population d'étude cible</label>\n                <textarea id=\"population\" placeholder=\"Ex: Adultes de 18-65 ans atteints de diabète de type 2 non contrôlé\"></textarea>\n\n                <h3>Sections Standardisées à Inclure</h3>\n                <div class=\"section-group\">\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Résumé du Protocole\" checked> Résumé du Protocole</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Contexte et Justification\"> Contexte et Justification</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Objectifs de l'Étude\"> Objectifs de l'Étude</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Critères d'Inclusion/Exclusion\"> Critères d'Inclusion/Exclusion</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Méthodologie de l'Étude\"> Méthodologie de l'Étude</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Collecte et Gestion des Données\"> Collecte et Gestion des Données</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Considérations Éthiques\"> Considérations Éthiques</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Plan d'Analyse Statistique\"> Plan d'Analyse Statistique</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Calendrier de l'Étude\"> Calendrier de l'Étude</label>\n                    <label><input type=\"checkbox\" name=\"sections\" value=\"Références\"> Références</label>\n                </div>\n\n                <button type=\"submit\" id=\"tool-submit\">Générer le Protocole</button>\n            </form>\n        </div>\n    </div>\n\n    <footer>\n        <div class=\"seo-block\">\n            <h2>Optimisation de la Recherche pour les Professionnels de la Recherche Clinique</h2>\n            <p>Notre outil de génération de protocole d'étude clinique est spécifiquement conçu pour répondre aux besoins des professionnels en France. Que vous soyez un chercheur académique, un médecin investigateur, ou un membre d'une Organisation de Recherche Contractuelle (CRO), vous trouverez ici une solution efficace pour la rédaction de vos documents clés. Facilitez la création de votre <strong>protocole de recherche clinique</strong>, <strong>protocole d'essai clinique</strong> ou <strong>plan d'étude clinique</strong>. Nous aidons à structurer des documents complexes pour les <strong>études interventionnelles</strong>, les <strong>essais de phase I, II, III, IV</strong>, et les <strong>études observationnelles</strong>.</p>\n            <p>Utilisez notre plateforme pour la <strong>conception de protocole médical</strong>, la <strong>génération de sections standardisées ICH-GCP</strong>, et l'<strong>accélération de la soumission réglementaire</strong>. Notre générateur est idéal pour les équipes nécessitant une <strong>ébauche de protocole rapide</strong>, un <strong>template de protocole d'étude</strong> ou un <strong>assistant de rédaction de protocole</strong>. Développé en tenant compte des exigences réglementaires françaises et européennes, il est un atout pour la <strong>gestion de projet clinique</strong> et l'<strong>optimisation des coûts de recherche</strong>.</p>\n            <ul>\n                <li>Protocole d'étude clinique</li>\n                <li>Générateur de protocole médical</li>\n                <li>Essai clinique France</li>\n                <li>Rédaction protocole ICH-GCP</li>\n                <li>Outil CRO recherche clinique</li>\n                <li>Conception étude interventionnelle</li>\n                <li>Modèle protocole essai clinique</li>\n                <li>Accélérer recherche médicale</li>\n                <li>Planification étude clinique</li>\n                <li>Logiciel protocole recherche</li>\n            </ul>\n        </div>\n        <p>&copy; 2023 Constructeur de Protocole d'Études Cliniques. Tous droits réservés.</p>\n    </footer>\n\n    <script>\n        document.getElementById('tool-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n\n            const studyTitle = document.getElementById('studyTitle').value;\n            const studyPhase = document.getElementById('studyPhase').value;\n            const therapeuticArea = document.getElementById('therapeuticArea').value;\n            const intervention = document.getElementById('intervention').value;\n            const population = document.getElementById('population').value;\n            const selectedSections = Array.from(document.querySelectorAll('input[name=\"sections\"]:checked')).map(cb => cb.value);\n\n            let protocolOutput = `\n### TITRE DU PROTOCOLE : ${studyTitle || '[Titre de l\\'étude Provisoire]'}\n\n### INFORMATIONS GÉNÉRALES\n*   **Phase de l'Étude :** ${studyPhase || '[Non spécifié]'}\n*   **Domaine Thérapeutique :** ${therapeuticArea || '[Non spécifié]'}\n*   **Intervention/Produit :** ${intervention || '[Non spécifié]'}\n*   **Population Cible :** ${population || '[Non spécifié]'}\n*   **Version du Protocole :** V1.0\n*   **Date :** ${new Date().toLocaleDateString('fr-FR')}\n\n`;\n\n            selectedSections.forEach(section => {\n                protocolOutput += `\n### ${section.toUpperCase()}\n`;\n                switch (section) {\n                    case \"Résumé du Protocole\":\n                        protocolOutput += `\n    Brève description de l'étude, incluant les objectifs principaux, le design, la population d'étude, l'intervention, et les résultats attendus. Cette section fournit un aperçu rapide du protocole complet.\n`;\n                        break;\n                    case \"Contexte et Justification\":\n                        protocolOutput += `\n    Description de la maladie ou de la condition à l'étude, l'état actuel des connaissances, les traitements existants, et le rationnel pour l'étude de l'intervention proposée.\n`;\n                        break;\n                    case \"Objectifs de l'Étude\":\n                        protocolOutput += `\n    **Objectif Principal :** [Ex: Évaluer l'efficacité du composé XYZ dans la réduction de la tension artérielle systolique.]\n    **Objectifs Secondaires :** [Ex: Évaluer la sécurité du composé XYZ, son impact sur les marqueurs biologiques secondaires.]\n`;\n                        break;\n                    case \"Critères d'Inclusion/Exclusion\":\n                        protocolOutput += `\n    **Critères d'Inclusion :**\n    *   [Ex: Hommes et femmes âgés de 18 à 65 ans.]\n    *   [Ex: Diagnostic confirmé de la maladie selon les critères de l'OMS.]\n    *   [Ex: Consentement éclairé signé.]\n\n    **Critères d'Exclusion :**\n    *   [Ex: Femmes enceintes ou allaitantes.]\n    *   [Ex: Antécédents de maladies cardiovasculaires graves.]\n    *   [Ex: Participation à une autre étude clinique au cours des 30 derniers jours.]\n`;\n                        break;\n                    case \"Méthodologie de l'Étude\":\n                        protocolOutput += `\n    **Design de l'Étude :** [Ex: Étude randomisée, en double aveugle, contrôlée par placebo, multicentrique.]\n    **Durée de l'Étude :** [Ex: 12 mois de traitement, suivi de 3 mois d'observation.]\n    **Nombre de Participants :** [Ex: 300 participants, répartis en groupes de traitement et placebo.]\n    **Procédures :** [Ex: Visites de dépistage, randomisation, administration du traitement, visites de suivi, collectes de sang et d'urine.]\n`;\n                        break;\n                    case \"Collecte et Gestion des Données\":\n                        protocolOutput += `\n    Description des méthodes de collecte des données (eCRF, formulaires papier), de leur saisie, de leur validation et de leur gestion pour assurer l'intégrité et la confidentialité.\n`;\n                        break;\n                    case \"Considérations Éthiques\":\n                        protocolOutput += `\n    Détail des mesures prises pour assurer la protection des droits et du bien-être des participants, y compris l'obtention du consentement éclairé, l'approbation du Comité d'Éthique, et la confidentialité des données.\n`;\n                        break;\n                    case \"Plan d'Analyse Statistique\":\n                        protocolOutput += `\n    Description des méthodes statistiques qui seront utilisées pour analyser les données de l'étude, y compris la taille de l'échantillon, les analyses primaires et secondaires, et la gestion des données manquantes.\n`;\n                        break;\n                    case \"Calendrier de l'Étude\":\n                        protocolOutput += `\n    Présentation des étapes clés et des délais prévus pour la réalisation de l'étude, de la soumission réglementaire à la publication des résultats.\n`;\n                        break;\n                    case \"Références\":\n                        protocolOutput += `\n    Liste des publications scientifiques et des directives réglementaires citées ou pertinentes pour la conception et l'exécution de l'étude.\n`;\n                        break;\n                    default:\n                        protocolOutput += `\n    Contenu détaillé pour la section \"${section}\".\n`;\n                        break;\n                }\n                protocolOutput += `\n`; // Add a newline for separation\n            });\n\n            document.getElementById('tool-result').innerHTML = `<div class=\"result-section\">${protocolOutput}</div>`;\n        });\n    </script>\n<div id=\"qa-smoke-result\" hidden></div>\n<script id=\"farmbuilder-affiliate-helper\">\n(function () {\n  window.__UTILITY_AFFILIATE_MAP = window.__UTILITY_AFFILIATE_MAP || {};\n  document.addEventListener(\"click\", function (event) {\n    const target = event.target.closest(\"[data-affiliate-slot]\");\n    if (!target) return;\n    const slot = target.getAttribute(\"data-affiliate-slot\");\n    const href = window.__UTILITY_AFFILIATE_MAP[slot];\n    if (!href) return;\n    if (target.tagName && target.tagName.toLowerCase() === \"a\") {\n      target.setAttribute(\"href\", href);\n      target.removeAttribute(\"rel\");\n      return;\n    }\n    event.preventDefault();\n    window.open(href, \"_blank\");\n  }, true);\n})();\n</script>\n<script id=\"farmbuilder-functional-qa\">\n(function () {\n  function marker() {\n    let node = document.getElementById(\"qa-smoke-result\");\n    if (node) return node;\n    node = document.createElement(\"div\");\n    node.id = \"qa-smoke-result\";\n    node.hidden = true;\n    document.body.appendChild(node);\n    return node;\n  }\n\n  let qaFinished = false;\n  let qaWatchdog = null;\n\n  function normalize(text) {\n    return String(text || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function findForm() {\n    return document.getElementById(\"tool-form\") || document.querySelector(\"form\");\n  }\n\n  function findResult() {\n    return (\n      document.getElementById(\"tool-result\") ||\n      document.querySelector(\"[data-result]\") ||\n      document.querySelector(\".tool-result, .result-card, .result, .results, .output, .preview, .diagnostic, .analysis\")\n    );\n  }\n\n  function primaryAction(form) {\n    if (!form) return null;\n    return (\n      document.getElementById(\"tool-submit\") ||\n      form.querySelector(\"#tool-submit\") ||\n      form.querySelector(\"[data-primary-action]\") ||\n      form.querySelector(\"button[type=submit]\") ||\n      form.querySelector(\"button\") ||\n      form.querySelector(\"input[type=submit]\")\n    );\n  }\n\n  function resultSignature(node) {\n    if (!node) return \"\";\n    const text = normalize(node.textContent);\n    const html = normalize(node.innerHTML).slice(0, 600);\n    return `${text}||${html}`;\n  }\n\n  function resultHeadline(node) {\n    if (!node) return \"\";\n    const heading = node.querySelector(\"h1, h2, h3, strong, b\");\n    return normalize(heading ? heading.textContent : \"\");\n  }\n\n  function sampleText(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"} ${field.placeholder || \"\"}`.toLowerCase();\n    if (/email/.test(key)) return \"bonjour@example.com\";\n    if (/url|site|website|lien/.test(key)) return \"https://example.com/offre-solaire\";\n    if (/phone|tel|mobile/.test(key)) return \"0612345678\";\n    if (/ville|city|localisation|location|region|departement|postal/.test(key)) return \"Paris\";\n    if (/orientation/.test(key)) return \"sud\";\n    if (/keyword|theme|topic|sujet|subject/.test(key)) return \"energie solaire domestique\";\n    if (/titre|title/.test(key)) return \"Simulateur solaire maison\";\n    if (/nom|name|project/.test(key)) return \"Projet Horizon\";\n    if (/description|notes|content|message/.test(key)) return \"Maison individuelle exposee sud avec toiture exploitable.\";\n    return field.placeholder || \"France\";\n  }\n\n  function sampleNumber(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"}`.toLowerCase();\n    if (/inclinaison|angle|slope/.test(key)) return \"30\";\n    if (/surface|size|m2|sqm/.test(key)) return \"28\";\n    if (/annee|year/.test(key)) return \"2024\";\n    if (/prix|price|budget|cost|amount|montant/.test(key)) return \"12000\";\n    const min = Number(field.min || \"\");\n    const max = Number(field.max || \"\");\n    if (Number.isFinite(min) && Number.isFinite(max) && max >= min) {\n      return String(Math.min(max, Math.max(min, min + Math.round((max - min) * 0.35))));\n    }\n    if (Number.isFinite(min)) return String(Math.max(min, 12));\n    if (Number.isFinite(max)) return String(Math.min(max, 12));\n    return field.value || \"12\";\n  }\n\n  function applySample(field) {\n    const tag = (field.tagName || \"\").toLowerCase();\n    const type = (field.type || \"\").toLowerCase();\n    if (field.disabled) return;\n    if (type === \"hidden\" || type === \"submit\" || type === \"button\" || type === \"reset\" || type === \"image\" || type === \"file\") {\n      return;\n    }\n    const currentValue = normalize(field.value);\n    if (tag === \"select\") {\n      if (currentValue) return;\n      const option = Array.from(field.options || []).find((item) => item.value && !item.disabled) || field.options[0];\n      if (option) field.value = option.value;\n      return;\n    }\n    if (type === \"checkbox\") {\n      if (field.checked) return;\n      field.checked = true;\n      return;\n    }\n    if (type === \"radio\") {\n      if (field.checked) return;\n      field.checked = true;\n      return;\n    }\n    if (type === \"date\") {\n      if (currentValue) return;\n      field.value = \"2026-03-01\";\n      return;\n    }\n    if (type === \"email\") {\n      if (currentValue) return;\n      field.value = \"bonjour@example.com\";\n      return;\n    }\n    if (type === \"url\") {\n      if (currentValue) return;\n      field.value = \"https://example.com/offre-solaire\";\n      return;\n    }\n    if (type === \"tel\") {\n      if (currentValue) return;\n      field.value = \"0612345678\";\n      return;\n    }\n    if (type === \"color\") {\n      if (currentValue) return;\n      field.value = \"#2f855a\";\n      return;\n    }\n    if (type === \"number\" || type === \"range\") {\n      if (currentValue) return;\n      field.value = sampleNumber(field);\n      return;\n    }\n    if (currentValue) return;\n    field.value = sampleText(field);\n  }\n\n  function stamp(status, detail, headline, primary) {\n    if (qaFinished) return;\n    qaFinished = true;\n    if (qaWatchdog) {\n      window.clearTimeout(qaWatchdog);\n      qaWatchdog = null;\n    }\n    const node = marker();\n    node.dataset.status = status;\n    node.dataset.mode = \"native-form\";\n    node.dataset.detail = detail || \"\";\n    node.dataset.headline = headline || \"\";\n    node.dataset.primary = primary || \"\";\n    node.dataset.viewport = window.innerWidth <= 640 ? \"mobile\" : \"desktop\";\n    window.setTimeout(function () {\n      try {\n        window.stop();\n      } catch (_error) {}\n    }, 0);\n  }\n\n  function installModalGuards() {\n    const noop = function () {};\n    const approve = function () { return true; };\n    const empty = function () { return \"\"; };\n    try { window.alert = noop; } catch (_error) {}\n    try { window.confirm = approve; } catch (_error) {}\n    try { window.prompt = empty; } catch (_error) {}\n  }\n\n  function triggerAction(form, action) {\n    try {\n      if (typeof form.requestSubmit === \"function\") {\n        form.requestSubmit(action || undefined);\n        return;\n      }\n    } catch (_error) {}\n    if (action && typeof action.click === \"function\") {\n      action.click();\n      return;\n    }\n    form.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }));\n  }\n\n  function inspectResult(before, attemptsLeft) {\n    const result = findResult();\n    if (!result) {\n      stamp(\"fail\", \"La zone de resultat est introuvable.\", \"\");\n      return;\n    }\n    const after = resultSignature(result);\n    const text = normalize(result.textContent);\n    if (after && after !== before && text.length >= 24) {\n      const primary = result.querySelector(\"a[href], button[data-href], [data-primary-url]\") || document.querySelector(\"#tool-result a[href]\");\n      stamp(\"pass\", \"Le formulaire natif a mis a jour la zone de resultat.\", resultHeadline(result), primary ? (primary.getAttribute(\"href\") || primary.getAttribute(\"data-primary-url\") || \"\") : \"\");\n      return;\n    }\n    if (attemptsLeft > 0) {\n      window.setTimeout(function () {\n        inspectResult(before, attemptsLeft - 1);\n      }, 250);\n      return;\n    }\n    stamp(\"fail\", \"La zone de resultat n'a pas renvoye de contenu exploitable.\", resultHeadline(result));\n  }\n\n  function runSmoke() {\n    const params = new URLSearchParams(window.location.search);\n    if (params.get(\"__qa\") !== \"functional\") return;\n    qaWatchdog = window.setTimeout(function () {\n      stamp(\"fail\", \"QA smoke timed out before the page reported a usable result.\", \"\");\n    }, 7000);\n    const form = findForm();\n    if (!form) {\n      stamp(\"fail\", \"Le formulaire principal est introuvable.\", \"\");\n      return;\n    }\n    const result = findResult();\n    const before = resultSignature(result);\n    installModalGuards();\n    try {\n      form.querySelectorAll(\"input, select, textarea\").forEach(applySample);\n    } catch (error) {\n      stamp(\"fail\", error && error.message ? `QA smoke sample failed: ${error.message}` : \"QA smoke sample failed before submit.\", \"\");\n      return;\n    }\n    const action = primaryAction(form);\n    try {\n      triggerAction(form, action);\n    } catch (error) {\n      stamp(\"fail\", error && error.message ? `QA smoke submit failed: ${error.message}` : \"QA smoke submit failed.\", \"\");\n      return;\n    }\n    inspectResult(before, 10);\n  }\n\n  window.addEventListener(\"error\", function (event) {\n    const message = event && event.message ? event.message : \"JavaScript runtime error during QA smoke.\";\n    stamp(\"fail\", `QA smoke JS error: ${message}`, \"\");\n  }, { once: true });\n\n  window.addEventListener(\"unhandledrejection\", function (event) {\n    const reason = event && event.reason;\n    const detail = typeof reason === \"string\"\n      ? reason\n      : reason && reason.message\n        ? reason.message\n        : \"Unhandled promise rejection during QA smoke.\";\n    stamp(\"fail\", `QA smoke rejection: ${detail}`, \"\");\n  }, { once: true });\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      window.setTimeout(runSmoke, 60);\n    }, { once: true });\n  } else {\n    window.setTimeout(runSmoke, 60);\n  }\n})();\n</script>\n</body>\n</html>",
